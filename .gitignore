node_modules
dist
.DS_Store
*.log

# --- Secrets -----------------------------------------------------------------
# `.env` alone was not enough: README.md tells you to put GEMINI_API_KEY in
# `.env.local`, which the old pattern did not match. One `git add -A` after a
# `npm run dev` and the key was in the history.
.env
.env.*
!.env.example

# --- Test and build output ---------------------------------------------------
coverage
playwright-report
test-results
# The evidence bundle is COMMITTED — CI verifies it, so it has to be in the
# checkout. Ignoring the whole directory made the attestation uncommittable and
# would have failed the Review attestation gate on every push.
#
# Two things stay out. Each pattern is on its own line with the comment ABOVE
# it: gitignore does not support a trailing comment, so `foo/  # why` becomes a
# pattern containing spaces and a hash, matches nothing, and silently ignores
# nothing. That mistake staged the full review prompt once.
#
# The full local review report. Quotes source lines and includes prompt.md.
.apexyard/review/
# Raw tool output — unnormalised, non-deterministic, absolute paths.
.apexyard/raw/

# --- Editors -----------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea

# The e2e build. Separate from dist/ on purpose — see playwright.config.ts.
dist-e2e/

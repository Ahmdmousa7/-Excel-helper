# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# EVERY `VITE_`-PREFIXED VALUE IS INLINED INTO THE BROWSER BUNDLE AT BUILD TIME.
# It is readable by anyone who opens devtools. Never put a server-side key,
# service-account credential, or OAuth client *secret* behind a VITE_ prefix.

# Gemini API key for the AI-backed tools (OCR, translate, support chat).
#
# This is a real secret and it WILL be visible in the shipped bundle. Scope it
# to the minimum, set quota limits and HTTP-referrer restrictions in Google
# Cloud, and rotate it if the site is public. The long-term fix is a small
# proxy endpoint that holds the key server-side — see docs/APEXYARD.md.
VITE_GEMINI_API_KEY=

# Google OAuth client ID for Sheets sync. Public by design — an OAuth client
# ID is an identifier, not a secret. Safe to ship.
VITE_GOOGLE_CLIENT_ID=

# Set only by `npm run build:e2e` and the Playwright web server. Do not set it
# by hand; a production build ignores it (see components/AuthWrapper.tsx).
# VITE_E2E_AUTH_BYPASS=true
